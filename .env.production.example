# Production environment for mazechase.co.zw
#
# Copy to .env on the server and fill in the blanks. Do not reuse the local
# APP_KEY or REVERB_* credentials — generate fresh ones here.
#
# IMPORTANT: the VITE_* values below are compiled into the JavaScript bundle at
# build time, not read at runtime. `npm run build` must run with THIS file in
# place, otherwise the browser will try to open a websocket to localhost:8080
# and no match will ever start.

APP_NAME="Maze Chase"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mazechase.co.zw

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mazechase
DB_USERNAME=
DB_PASSWORD=

# Guests are identified by a session token, so sessions must survive restarts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Realtime. Generate credentials with: php artisan reverb:install
# REVERB_HOST/PORT/SCHEME are what the *browser* dials, so they point at the
# public domain on 443; the Reverb process itself listens on REVERB_SERVER_PORT
# behind the web server, which proxies /app and /apps to it.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="mazechase.co.zw"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The game engine keeps live match state here; it is not optional.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Absolute path to the PHP *CLI* binary, used to spawn the game:tick loop.
# Required under PHP-FPM, where PHP_BINARY resolves to the FPM daemon rather
# than a runnable CLI: matches would start and then sit frozen. Leave unset
# locally (artisan serve resolves PHP_BINARY correctly on its own).
GAME_PHP_BINARY=/usr/bin/php8.5

MAIL_MAILER=log
